DirectoryIndex index.php

# ---------------------------------------------------------------------------
# Self-hosted brand font.
#
# Declared here rather than relying on the server: a host that does not know
# .woff2 serves it as application/octet-stream and the browser silently refuses
# the font, dropping every visitor to the fallback stack.
# ---------------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType font/woff  .woff
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType text/css "access plus 1 day"
  ExpiresByType application/javascript "access plus 1 day"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(?:webp|png|jpe?g|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(?:css|js)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>

  <FilesMatch "\.woff2?$">
    Header set Cache-Control "public, max-age=31536000, immutable"
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>
  <FilesMatch "\.(?:php|html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# ---------------------------------------------------------------------------
# Security headers
# ---------------------------------------------------------------------------
ServerSignature Off

<IfModule mod_headers.c>
  # Never let a browser guess a response type (blocks sniffing an upload as script).
  Header always set X-Content-Type-Options "nosniff"
  # No other site may frame these pages (clickjacking).
  Header always set X-Frame-Options "SAMEORIGIN"
  # Do not leak the full admin URL to third parties.
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Nothing here needs the camera, microphone or location.
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  # Hide the exact PHP build.
  Header always unset X-Powered-By

  # Content Security Policy. 'unsafe-inline' is still required for the few inline
  # scripts and style attributes in the pages. The brand font is self-hosted, so the
  # Google Fonts hosts are gone and only the QR host remains off-origin.
  #
  # frame-src carries the YouTube player the approach steps open. Without it the
  # default-src rule blocks the iframe and the browser shows "This content is
  # blocked" in place of the video.
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; object-src 'none'; img-src 'self' data: https://api.qrserver.com; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self' 'unsafe-inline'; connect-src 'self' https://api.qrserver.com; frame-src https://www.youtube-nocookie.com https://www.youtube.com"
</IfModule>

# ---------------------------------------------------------------------------
# Files that must never be served, however the project is reached.
# Matters as soon as the site is opened to the LAN: the repository alone would
# hand a visitor the full source, and cols.txt is a schema scratch file.
# ---------------------------------------------------------------------------
RedirectMatch 404 (?i)/\.git(/|$)

<FilesMatch "(?i)^(\.git.*|cols\.txt|.*\.(?:md|sample\.php|log|sql|bak))$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
